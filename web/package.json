{
  "name": "ratelab-playground",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "Interactive playground for the distributed rate limiter, running the real Rust code as WebAssembly.",
  "scripts": {
    "wasm": "sh scripts/build-wasm.sh",
    "data": "node scripts/copy-results.mjs",
    "prepare-assets": "npm run wasm && npm run data",
    "dev": "npm run prepare-assets && vite",
    "build": "npm run prepare-assets && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "marked": "^16.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
