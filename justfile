# Task runner: https://github.com/casey/just (`cargo install just --locked`).
# `just` with no arguments lists the recipes.

set shell := ["bash", "-euo", "pipefail", "-c"]

compose := "docker compose -f deploy/docker-compose.yml"

# List the recipes.
default:
    @just --list

# fmt, clippy and the tests that need no Docker.
test:
    cargo fmt --all -- --check
    cargo clippy --workspace --all-targets -- -D warnings
    cargo test --workspace

# The tests that start Redis with testcontainers (needs Docker).
test-docker:
    cargo test --workspace -- --ignored

# Reproduce every number in results/RESULTS.md and the README (needs Docker).
# Downloads and containers are removed as each step finishes; only results/ is kept.
results: bench traces overload llm cluster cluster-strategies report story

# A public request log (downloaded into memory, never saved) through every algorithm
# and strategy: results/traces.json.
traces quick="false":
    cargo run -p bench --release -- traces {{ if quick == "true" { "--quick" } else { "" } }}

# In-process suite, memory per key and the strategy simulation:
# results/local.json, results/memory.json, results/strategies.json.
bench:
    cargo run -p bench --release -- local
    cargo run -p bench --release --bin memory
    cargo run -p bench --release -- strategies

# Concurrency limits under overload, simulated and on the real Tower layer (about 5
# minutes, in-process, no Docker): results/overload.json.
overload quick="false":
    cargo run -p bench --release -- overload {{ if quick == "true" { "--quick" } else { "" } }}

# Token limits for LLM traffic on a real trace (downloaded into memory, never saved),
# plus a real-time check through the server's layer: results/llm.json.
llm quick="false":
    cargo run -p bench --release -- llm {{ if quick == "true" { "--quick" } else { "" } }}

# Three nodes + Redis + load generator in Docker Compose: results/cluster.json.
cluster quick="false":
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p results
    export DRL_QUICK={{quick}}
    export DRL_HOST="$(cargo run -q -p bench --release -- machine)"
    export DRL_GIT_COMMIT="$(cargo run -q -p bench --release -- machine | sed -n 's/.*commit `\(.*\)`.*/\1/p')"
    # Remove containers, networks, volumes and every image this run built or pulled.
    trap '{{compose}} down --rmi all --volumes --remove-orphans >/dev/null 2>&1; docker image prune -f >/dev/null 2>&1' EXIT
    {{compose}} up --build --abort-on-container-exit --exit-code-from loadgen

# Every coordination strategy on the real 3-node cluster, against the simulator:
# results/real_strategies.json.
cluster-strategies quick="false":
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p results
    export DRL_QUICK={{quick}}
    export DRL_HOST="$(cargo run -q -p bench --release -- machine)"
    export DRL_GIT_COMMIT="$(cargo run -q -p bench --release -- machine | sed -n 's/.*commit `\(.*\)`.*/\1/p')"
    files="-f deploy/docker-compose.yml -f deploy/docker-compose.strategies.yml"
    trap "docker compose $files down --rmi all --volumes --remove-orphans >/dev/null 2>&1; docker image prune -f >/dev/null 2>&1" EXIT
    docker compose $files up --build --abort-on-container-exit --exit-code-from loadgen

# Check the ratelab crate is ready to publish: strict docs, doc tests, a packaging dry
# run, and (once a version is on crates.io) cargo-semver-checks against it.
release-check:
    RUSTDOCFLAGS="-D warnings" cargo doc -p ratelab --no-deps
    cargo test -p ratelab --doc
    cargo publish -p ratelab --dry-run
    if command -v cargo-semver-checks >/dev/null; then cargo semver-checks -p ratelab; else echo "cargo-semver-checks not installed: cargo install cargo-semver-checks --locked"; fi

# Install the ratelab command from this checkout.
cli:
    cargo install --path crates/cli --locked

# The report and the private story drafts, every number filled in from results/:
# docs/report/*.md and its PDF, and target/story/*.md (not committed).
story:
    cargo run -p bench --release -- story
    node web/scripts/report-pdf.mjs

# Free the rebuildable caches: Rust build output and Docker's build cache (all of it).
clean:
    cargo clean
    docker builder prune -f

# Regenerate results/RESULTS.md and the README table from the JSON files.
report:
    cargo run -p bench --release -- report

# The whole pipeline with tiny sizes, into target/smoke (numbers not meaningful).
smoke:
    mkdir -p target/smoke
    cargo run -p bench --release -- local --quick --out target/smoke/local.json
    cargo run -p bench --release --bin memory -- --quick --out target/smoke/memory.json
    cargo run -p bench --release -- strategies --quick --out target/smoke/strategies.json
    cargo run -p bench --release -- overload --quick --out target/smoke/overload.json
    cargo run -p bench --release -- llm --quick --out target/smoke/llm.json
    printf '<!-- results:start (generated by `just results`, do not edit) -->\n<!-- results:end -->\n' > target/smoke/README.md
    cargo run -p bench --release -- report --dir target/smoke --readme target/smoke/README.md

# The playground in development mode (hot reload) on http://localhost:5173.
play:
    cd web && npm install && npm run dev

# Build the playground into web/dist (the server and GitHub Pages serve it).
site:
    cd web && npm ci && npm run build

# Playground tests: types, log parser, end-to-end and accessibility (needs `just site`).
test-web:
    cd web && npx tsc --noEmit && node --test tests/logs.test.ts && npx playwright test

# Run the server with the in-process limiter on http://localhost:3001 (serves web/dist if built).
serve:
    cargo run -p server --bin web-server

# Criterion micro-benchmarks (HTML report in target/criterion).
criterion:
    cargo bench -p bench
